# Optional. Frankfurter is used by default and needs no key.
FX_API_URL=https://api.frankfurter.dev/v1

# Optional eBay Finding API app id. HTML search is used if this is empty.
EBAY_APP_ID=

# Optional. Comma-separated cookie header for Xianyu/Goofish if the public search is blocked.
XIANYU_COOKIE=

# Scheduler (24h clock, local machine timezone)
COLLECT_CRON_HOUR=0
COLLECT_CRON_MINUTE=0
COLLECT_ON_STARTUP=false

# Bound native prices that are obviously not the sealed product.
SIGNATURE_USD_MIN=300
SIGNATURE_USD_MAX=8000
PLAYER_USD_MIN=20
PLAYER_USD_MAX=250
